# wasmmod-cdn local defaults (copy to .env)
WASMMOD_CDN_DATA_DIR=.data
WASMMOD_CDN_DATABASE_URL=sqlite+aiosqlite:///.data/wasmmod_cdn.db
WASMMOD_CDN_STORAGE_ROOT=.data/packs
WASMMOD_CDN_DEBUG=true
WASMMOD_CDN_HOST=0.0.0.0
WASMMOD_CDN_PORT=8000
WASMMOD_CDN_BASE_PATH=/cdn
WASMMOD_CDN_BEHIND_PROXY=true
WASMMOD_CDN_SESSION_SECRET=dev-change-me-wasmmod-cdn
WASMMOD_CDN_REQUIRE_AUTH=false
WASMMOD_CDN_ALLOW_OPEN_REGISTRATION=true
WASMMOD_CDN_AUTO_CLAIM_ON_PUBLISH=true
WASMMOD_CDN_PIN_IMMUTABLE=true
WASMMOD_CDN_CSRF_ENABLED=true
WASMMOD_CDN_RATE_LIMIT_ENABLED=true

# --- Public-test / docker (scripts/dev-up.sh defaults) -----------------
# Prefer gitignored .secrets/ over putting passwords in .env:
#   ./scripts/ensure-secrets.sh
#   → .secrets/cdn.env   (BOOTSTRAP_ADMIN_EMAIL + PASSWORD)
#   → .secrets/token     (minted by dev-up after boot; seed/CI Bearer)
#
# WASMMOD_CDN_REQUIRE_AUTH=true
# WASMMOD_CDN_ALLOW_OPEN_REGISTRATION=false
# WASMMOD_CDN_BOOTSTRAP_ADMIN_EMAIL=demo@cdn.pymergetic.com
# WASMMOD_CDN_BOOTSTRAP_ADMIN_PASSWORD=  # set via ensure-secrets.sh
# (EmailStr rejects RFC 6761 special-use TLDs — no .local / .test)
# (with REQUIRE_AUTH=true, open registration defaults to false unless set true)
#
# Change password later: POST /auth/password with current + new (session or Bearer).

# WASMMOD_CDN_PUBLIC_ORIGIN=https://cdn.example.com
# Absolute public origin for links / Secure cookies (https://…). Required behind TLS.
#
# Forks / private mirrors — keep BASE_PATH + PUBLIC_ORIGIN accurate so devices and
# wasm.cdn(url) / multi-CDN import paths resolve packs against *your* host.
# WASMMOD_CDN_BRAND_NAME=acme-cdn
# WASMMOD_CDN_BRAND_LOGO_URL=https://cdn.example.com/static/img/logo.png
#   # or site path: /cdn/static/img/logo.png  |  or: img/logo.png under static/
# WASMMOD_CDN_CORS_ORIGINS=["*"]
#   # ["*"] = any origin, credentials off (default). Explicit list for cookie UIs.
#   # Empty list [] disables CORS middleware.
#
# Federation control plane (read proxy later) — see docs/FEDERATION.md
# WASMMOD_CDN_FEDERATION_SECRETS_KEY=
# WASMMOD_CDN_FEDERATION_MAX_HOPS=8
# Bootstrap mounts — applied on startup if prefix missing (DB/admin wins if present):
# WASMMOD_CDN_FEDERATION_MOUNTS_JSON=[{"prefix":"a.b","url":"https://leaf.example/cdn","token":"mcdn_…"}]
#
# WASMMOD_CDN_DATABASE_URL=postgresql+asyncpg://metal:metal@127.0.0.1:5432/wasmmod_cdn
# Storage: local (default) or S3/MinIO
# WASMMOD_CDN_STORAGE_BACKEND=s3
# WASMMOD_CDN_S3_ENDPOINT=http://127.0.0.1:9000
# WASMMOD_CDN_S3_BUCKET=wasmmod-cdn
# WASMMOD_CDN_S3_ACCESS_KEY=metal
# WASMMOD_CDN_S3_SECRET_KEY=metalmetal
# WASMMOD_CDN_S3_REGION=us-east-1
# Optional HMAC for signed index.json
# WASMMOD_CDN_INDEX_SIGNING_KEY=dev-index-hmac
# Publish policy for uploaded packs: off | present | verify (dev-up defaults to present)
# WASMMOD_CDN_REQUIRE_SIGNED=present
# WASMMOD_CDN_JSON_LOGS=true
# WASMMOD_CDN_METRICS_ENABLED=true
