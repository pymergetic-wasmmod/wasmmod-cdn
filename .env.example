# metal-cdn local defaults (copy to .env)
METAL_CDN_DATA_DIR=.data
METAL_CDN_DATABASE_URL=sqlite+aiosqlite:///.data/metal_cdn.db
METAL_CDN_STORAGE_ROOT=.data/packs
METAL_CDN_DEBUG=true
METAL_CDN_HOST=0.0.0.0
METAL_CDN_PORT=8000
METAL_CDN_BASE_PATH=/cdn
METAL_CDN_BEHIND_PROXY=true
METAL_CDN_SESSION_SECRET=dev-change-me-metal-cdn
METAL_CDN_REQUIRE_AUTH=false
METAL_CDN_ALLOW_OPEN_REGISTRATION=true
METAL_CDN_AUTO_CLAIM_ON_PUBLISH=true
METAL_CDN_PIN_IMMUTABLE=true
METAL_CDN_CSRF_ENABLED=true
METAL_CDN_RATE_LIMIT_ENABLED=true

# --- Public-test / docker (scripts/dev-up.sh defaults) -----------------
# Prefer gitignored .secrets/ over putting passwords in .env:
#   ./scripts/ensure-secrets.sh
#   → .secrets/cdn.env   (BOOTSTRAP_ADMIN_EMAIL + PASSWORD)
#   → .secrets/token     (minted by dev-up after boot; seed/CI Bearer)
#
# METAL_CDN_REQUIRE_AUTH=true
# METAL_CDN_ALLOW_OPEN_REGISTRATION=false
# METAL_CDN_BOOTSTRAP_ADMIN_EMAIL=demo@cdn.pymergetic.com
# METAL_CDN_BOOTSTRAP_ADMIN_PASSWORD=  # set via ensure-secrets.sh
# (EmailStr rejects RFC 6761 special-use TLDs — no .local / .test)
# (with REQUIRE_AUTH=true, open registration defaults to false unless set true)
#
# Change password later: POST /auth/password with current + new (session or Bearer).

# METAL_CDN_PUBLIC_ORIGIN=https://cdn.example.com
# Absolute public origin for links / Secure cookies (https://…). Required behind TLS.
#
# Forks / private mirrors — keep BASE_PATH + PUBLIC_ORIGIN accurate so devices and
# wasm.cdn(url) / multi-CDN import paths resolve packs against *your* host.
# METAL_CDN_BRAND_NAME=acme-cdn
# METAL_CDN_BRAND_LOGO_URL=https://cdn.example.com/static/img/logo.png
#   # or site path: /cdn/static/img/logo.png  |  or: img/logo.png under static/
# METAL_CDN_CORS_ORIGINS=["*"]
#   # ["*"] = any origin, credentials off (default). Explicit list for cookie UIs.
#   # Empty list [] disables CORS middleware.
#
# METAL_CDN_DATABASE_URL=postgresql+asyncpg://metal:metal@127.0.0.1:5432/metal_cdn
# Storage: local (default) or S3/MinIO
# METAL_CDN_STORAGE_BACKEND=s3
# METAL_CDN_S3_ENDPOINT=http://127.0.0.1:9000
# METAL_CDN_S3_BUCKET=metal-cdn
# METAL_CDN_S3_ACCESS_KEY=metal
# METAL_CDN_S3_SECRET_KEY=metalmetal
# METAL_CDN_S3_REGION=us-east-1
# Optional HMAC for signed index.json
# METAL_CDN_INDEX_SIGNING_KEY=dev-index-hmac
# Publish policy for uploaded packs: off | present | verify (dev-up defaults to present)
# METAL_CDN_REQUIRE_SIGNED=present
# METAL_CDN_JSON_LOGS=true
# METAL_CDN_METRICS_ENABLED=true
