{
  "include": ["pymergetic", "tests"],
  "exclude": ["**/.venv", "**/__pycache__", ".data", "client/*.egg-info", "**/*.tpl.py"],
  "extraPaths": ["."],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["."],
      "pythonVersion": "3.12"
    }
  ]
}
